From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: herdr maintainers <maintainers@herdr.dev>
Date: Tue, 08 Sep 2026 00:00:00 +0000
Subject: [PATCH] expose modifyOtherKeys mode through terminal data

Herdr must know whether xterm modifyOtherKeys mode 2 is active to request
printable key releases from the outer terminal. modifyOtherKeys is a terminal
flag rather than a DEC mode, so the generic mode query cannot reach it, and the
formatter API can only recover the fact by formatting the whole screen.

Vendored base: 448062571c5edf010b7490d06869b88b5ebf8f80
---
diff --git a/vendor/libghostty-vt/include/ghostty/vt/terminal.h b/vendor/libghostty-vt/include/ghostty/vt/terminal.h
--- a/vendor/libghostty-vt/include/ghostty/vt/terminal.h
+++ b/vendor/libghostty-vt/include/ghostty/vt/terminal.h
@@ -1951,6 +1951,13 @@
    * Output type: size_t *
    */
   GHOSTTY_TERMINAL_DATA_CLIPBOARD_WRITE_MAX_BYTES = 40,
+
+  /**
+   * Whether xterm modifyOtherKeys mode 2 is enabled.
+   *
+   * Output type: bool *
+   */
+  GHOSTTY_TERMINAL_DATA_MODIFY_OTHER_KEYS = 41,
   GHOSTTY_TERMINAL_DATA_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
 } GhosttyTerminalData;
 
diff --git a/vendor/libghostty-vt/src/terminal/c/terminal.zig b/vendor/libghostty-vt/src/terminal/c/terminal.zig
--- a/vendor/libghostty-vt/src/terminal/c/terminal.zig
+++ b/vendor/libghostty-vt/src/terminal/c/terminal.zig
@@ -1590,6 +1590,7 @@
     vt_ground = 38,
     cursor_at_prompt = 39,
     clipboard_write_max_bytes = 40,
+    modify_other_keys = 41,
 
     /// Output type expected for querying the data of the given kind.
     pub fn OutType(comptime self: TerminalData) type {
@@ -1603,6 +1604,7 @@
             .vt_processing_error,
             .vt_ground,
             .cursor_at_prompt,
+            .modify_other_keys,
             => bool,
             .active_screen => TerminalScreen,
             .kitty_keyboard_flags => u8,
@@ -1772,6 +1774,7 @@
             out.value = t.modes.get(mode);
         },
         .cursor_at_prompt => out.* = t.cursorIsAtPrompt(),
+        .modify_other_keys => out.* = t.flags.modify_other_keys_2,
     }
 
     return .success;
